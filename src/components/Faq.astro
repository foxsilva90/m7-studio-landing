---
import SectionHead from "./SectionHead.astro";
import { faq } from "../data/site";
---

<section class="section" id="faq">
  <div class="shell">
    <div class="section__grid">
      <SectionHead index="05" kicker="Dúvidas" title="O que costumam perguntar">
        <div class="faq">
          {
            faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </SectionHead>
    </div>
  </div>
</section>
