---
import SectionHead from "./SectionHead.astro";
import { stats } from "../data/site";
---

<section class="section" id="estudio">
  <div class="shell">
    <div class="section__grid">
      <SectionHead
        index="01"
        kicker="O Estúdio"
        title="Um espaço feito só para gravar áudio e vídeo"
      >
        <p class="section__lead">
          O M7 Studio existe para quem quer produzir o próprio podcast sem montar
          um estúdio em casa. O ambiente já está climatizado, iluminado e com
          tratamento acústico — o áudio sai limpo e o vídeo com cara de canal
          profissional.
        </p>
        <ul class="stats">
          {
            stats.map((s) => (
              <li>
                <div class="n">{s.num}</div>
                <div class="k">{s.label}</div>
              </li>
            ))
          }
        </ul>
      </SectionHead>
    </div>
  </div>
</section>
