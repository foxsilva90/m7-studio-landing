---
import SectionHead from "./SectionHead.astro";
import { steps } from "../data/site";
---

<section class="section" id="como">
  <div class="shell">
    <div class="section__grid">
      <SectionHead
        index="03"
        kicker="Como funciona"
        title="Da reserva ao episódio pronto em quatro passos"
      >
        <ol class="steps">
          {
            steps.map((s) => (
              <li>
                <div class="st">{s.tc}</div>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </SectionHead>
    </div>
  </div>
</section>
