---
import { steps } from "../data/site";
---

<section class="band" id="como">
  <div class="wrap">
    <p class="eyebrow">Como Funciona</p>
    <h2>Da reserva ao episódio pronto em quatro passos</h2>
    <div class="steps">
      {
        steps.map((s) => (
          <div class="step">
            <div class="tc">{s.tc}</div>
            <div>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
