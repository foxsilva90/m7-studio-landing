---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Studio from "../components/Studio.astro";
import Structure from "../components/Structure.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Plans from "../components/Plans.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Studio />
    <Structure />
    <HowItWorks />
    <Plans />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>

<script>
  import { initMotion } from "../scripts/motion";

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  initMotion(reduce);

  // movimento reduzido: vídeo do hero fica parado no pôster
  const video = document.querySelector<HTMLVideoElement>(".hero__video");
  if (video && reduce) {
    video.removeAttribute("autoplay");
    video.pause();
  }
</script>
