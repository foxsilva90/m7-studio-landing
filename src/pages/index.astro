---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Studio from "../components/Studio.astro";
import Structure from "../components/Structure.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Plans from "../components/Plans.astro";
import Faq from "../components/Faq.astro";
import FinalCta from "../components/FinalCta.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Nav />
  <main>
    <Hero />
    <Studio />
    <Structure />
    <HowItWorks />
    <Plans />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Base>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  document.documentElement.classList.add("js");

  // reveal ao rolar
  const revEls = document.querySelectorAll<HTMLElement>(
    ".section__grid > *, .hero__inner > *",
  );
  const revealAll = () => revEls.forEach((el) => el.classList.add("in"));
  revEls.forEach((el) => el.classList.add("reveal"));

  if ("IntersectionObserver" in window && !reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add("in");
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -6% 0px" },
    );
    revEls.forEach((el) => io.observe(el));
    setTimeout(revealAll, 2500);
  } else {
    revealAll();
  }
</script>
